//@version=6
indicator("短期 / 中期市场结构", overlay = true, max_lines_count = 500, max_labels_count = 500)

groupShort = "短期结构"
leftBars = input.int(1, "左侧确认 K 线数", minval = 1, maxval = 20, group = groupShort)
rightBars = input.int(1, "右侧确认 K 线数", minval = 1, maxval = 20, group = groupShort)
showShortPoints = input.bool(true, "显示短期点", group = groupShort)
showShortLines = input.bool(true, "显示短期结构线", group = groupShort)

groupMid = "中期结构"
trend = input.string("上涨", "已定义的趋势", options = ["上涨", "下跌"], group = groupMid)
startTime = input.time(timestamp("01 Jan 2020 00:00 +0000"), "趋势起始时间", group = groupMid)
breakMode = input.string("影线", "突破依据", options = ["影线", "收盘价"], group = groupMid)
showMidPoints = input.bool(true, "显示中期点", group = groupMid)
showMidLines = input.bool(true, "显示中期结构线", group = groupMid)

shortColor = color.new(color.teal, 15)
midColor = color.rgb(194, 64, 55)
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)
// 同一根 K 线同时形成高低点时，日内先后顺序未知，不强行连接。
ambiguous = not na(ph) and not na(pl)
newHigh = not na(ph) and not ambiguous
newLow = not na(pl) and not ambiguous
plotshape(showShortPoints and newHigh ? ph : na, "短期高点", shape.triangledown, location.absolute, shortColor, offset = -rightBars, size = size.tiny)
plotshape(showShortPoints and newLow ? pl : na, "短期低点", shape.triangleup, location.absolute, shortColor, offset = -rightBars, size = size.tiny)

var int lastType = 0
var float lastPrice = na
var int lastIndex = na
var line lastShortLine = na

// 相邻同类点只保留更极端的点；折线只连接不同类的点。
// 内包结构的合并尚未自动化：短期标记保留原始孤立点，便于人工核对。
if newHigh or newLow
    int pointType = newHigh ? 1 : -1
    float pointPrice = newHigh ? ph : pl
    int pointIndex = bar_index - rightBars
    bool moreExtreme = pointType == 1 ? pointPrice > lastPrice : pointPrice < lastPrice
    if lastType == pointType
        if moreExtreme
            lastPrice := pointPrice
            lastIndex := pointIndex
            if not na(lastShortLine)
                line.set_x2(lastShortLine, pointIndex)
                line.set_y2(lastShortLine, pointPrice)
    else
        if lastType != 0 and showShortLines
            lastShortLine := line.new(lastIndex, lastPrice, pointIndex, pointPrice, color = shortColor, width = 1)
        lastType := pointType
        lastPrice := pointPrice
        lastIndex := pointIndex

// 中期确认使用已确认的短期点。突破只在确认 K 线及其后发生，
// 避免将右侧确认期间的历史价格当作事先已知的信号。
inTrend = time >= startTime
pointInTrend = time[rightBars] >= startTime
breakUp = breakMode == "影线" ? high : close
breakDown = breakMode == "影线" ? low : close
var float previousShortLow = na
var int previousShortLowIndex = na
var float previousShortHigh = na
var int previousShortHighIndex = na
var float candidateHigh = na
var int candidateHighIndex = na
var float candidateHighBase = na
var float candidateLow = na
var int candidateLowIndex = na
var float candidateLowBase = na
var float confirmedMidHigh = na
var float confirmedMidLow = na
var float pendingLow = na
var int pendingLowIndex = na
var float pendingHigh = na
var int pendingHighIndex = na
var int lastMidType = 0
var float lastMidPrice = na
var int lastMidIndex = na
var line lastMidLine = na

if inTrend
    if newLow and pointInTrend
        previousShortLow := pl
        previousShortLowIndex := bar_index - rightBars
        if trend == "上涨" and ((not na(candidateHighIndex) and previousShortLowIndex > candidateHighIndex) or (not na(confirmedMidHigh) and previousShortLowIndex > lastMidIndex))
            if na(pendingLow) or pl < pendingLow
                pendingLow := pl
                pendingLowIndex := previousShortLowIndex
    if newHigh and pointInTrend
        previousShortHigh := ph
        previousShortHighIndex := bar_index - rightBars
        if trend == "下跌" and ((not na(candidateLowIndex) and previousShortHighIndex > candidateLowIndex) or (not na(confirmedMidLow) and previousShortHighIndex > lastMidIndex))
            if na(pendingHigh) or ph > pendingHigh
                pendingHigh := ph
                pendingHighIndex := previousShortHighIndex

    if trend == "上涨" and newHigh and pointInTrend and not na(previousShortLow) and previousShortLowIndex < previousShortHighIndex
        if na(candidateHigh) or ph > candidateHigh
            candidateHigh := ph
            candidateHighIndex := previousShortHighIndex
            candidateHighBase := previousShortLow
    if trend == "下跌" and newLow and pointInTrend and not na(previousShortHigh) and previousShortHighIndex < previousShortLowIndex
        if na(candidateLow) or pl < candidateLow
            candidateLow := pl
            candidateLowIndex := previousShortLowIndex
            candidateLowBase := previousShortHigh

    bool midHighEvent = trend == "上涨" and not na(candidateHighBase) and breakDown < candidateHighBase and bar_index > candidateHighIndex
    bool midLowEvent = trend == "下跌" and not na(candidateLowBase) and breakUp > candidateLowBase and bar_index > candidateLowIndex
    bool recoveryUp = trend == "上涨" and not na(confirmedMidHigh) and not na(pendingLow) and breakUp > confirmedMidHigh
    bool recoveryDown = trend == "下跌" and not na(confirmedMidLow) and not na(pendingHigh) and breakDown < confirmedMidLow

    if midHighEvent
        confirmedMidHigh := candidateHigh
        if na(pendingLowIndex) or pendingLowIndex <= candidateHighIndex
            pendingLow := na
            pendingLowIndex := na
        if showMidPoints
            label.new(candidateHighIndex, candidateHigh, "中高", style = label.style_label_down, color = midColor, textcolor = color.white, size = size.tiny)
        if lastMidType != 0 and showMidLines
            lastMidLine := line.new(lastMidIndex, lastMidPrice, candidateHighIndex, candidateHigh, color = midColor, width = 2)
        lastMidType := 1
        lastMidPrice := candidateHigh
        lastMidIndex := candidateHighIndex
        candidateHigh := na
        candidateHighBase := na
    else if recoveryUp
        confirmedMidLow := pendingLow
        if showMidPoints
            label.new(pendingLowIndex, pendingLow, "中低", style = label.style_label_up, color = midColor, textcolor = color.white, size = size.tiny)
        if showMidLines
            lastMidLine := line.new(lastMidIndex, lastMidPrice, pendingLowIndex, pendingLow, color = midColor, width = 2)
        lastMidType := -1
        lastMidPrice := pendingLow
        lastMidIndex := pendingLowIndex
        confirmedMidHigh := na
        pendingLow := na

    if midLowEvent
        confirmedMidLow := candidateLow
        if na(pendingHighIndex) or pendingHighIndex <= candidateLowIndex
            pendingHigh := na
            pendingHighIndex := na
        if showMidPoints
            label.new(candidateLowIndex, candidateLow, "中低", style = label.style_label_up, color = midColor, textcolor = color.white, size = size.tiny)
        if lastMidType != 0 and showMidLines
            lastMidLine := line.new(lastMidIndex, lastMidPrice, candidateLowIndex, candidateLow, color = midColor, width = 2)
        lastMidType := -1
        lastMidPrice := candidateLow
        lastMidIndex := candidateLowIndex
        candidateLow := na
        candidateLowBase := na
    else if recoveryDown
        confirmedMidHigh := pendingHigh
        if showMidPoints
            label.new(pendingHighIndex, pendingHigh, "中高", style = label.style_label_down, color = midColor, textcolor = color.white, size = size.tiny)
        if showMidLines
            lastMidLine := line.new(lastMidIndex, lastMidPrice, pendingHighIndex, pendingHigh, color = midColor, width = 2)
        lastMidType := 1
        lastMidPrice := pendingHigh
        lastMidIndex := pendingHighIndex
        confirmedMidLow := na
        pendingHigh := na

alertcondition(newHigh, "短期高点确认", "短期高点已确认")
alertcondition(newLow, "短期低点确认", "短期低点已确认")
