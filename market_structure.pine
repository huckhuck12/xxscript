//@version=6
indicator("短期 / 中期市场结构", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 250, max_bars_back = 100)

groupCommon = "01 常用显示与方向"
groupAlerts = "02 到价提醒（需创建 TradingView 警报）"
groupShort = "高级 · 短期结构"
groupMid = "高级 · 中期结构"
groupSetup = "高级 · 回撤与扫荡"
groupMomentum = "高级 · 趋势 K 线"
groupBreakZones = "高级 · OB / FVG"
groupHistory = "高级 · 历史与数量"
groupFib = "高级 · 参考线与颜色"
advancedSettings = input.bool(false, "启用高级参数调整", tooltip = "日常只需调整常用显示、方向和提醒。高级参数保留当前值，开启后才可编辑；并非隐藏参数。顺势标注使用回撤框的中期方向，灰色历史框不代表当前机会。", group = groupCommon, display = display.none)

trendMode = input.string("自动/双向", "趋势模式", options = ["上涨", "下跌", "自动/双向"], tooltip = "上涨或下跌只运行对应的中期确认规则；自动/双向同时维护两套候选，并按所选突破依据触发方向切换。方向切换不代表突破已站稳。", group = groupCommon, display = display.none)
showMidPoints = input.bool(true, "显示中期点", tooltip = "中期高低点在价格突破基准后才确认，标签回绘到原始极值位置。", group = groupCommon, display = display.none)
showMidLines = input.bool(true, "显示中期结构线", tooltip = "连接最终保留的中期高低点；后续新点可能使末端结构线重新整理。", group = groupCommon, display = display.none)
showSetupZone = input.bool(true, "显示候选回撤区", tooltip = "仅以已确认的中期顺势摆动定回撤区。按下方设置可在触区后顺势离开时结束机会。与上方顺势交易回撤线通常二选一显示；关闭此框不停止信号计算。", group = groupCommon, display = display.none)
showSetupInvalidation = input.bool(true, "显示摆动失效位", tooltip = "细线标出当前顺势摆动的起点；价格触及后，该摆动的回撤机会失效。", group = groupCommon, display = display.none)
showSweepTarget = input.bool(true, "显示待扫短期点", tooltip = "短虚线标出当前已确认、可用于扫荡判断的最近短期低点或高点；随新短期点更新。", group = groupCommon, display = display.none)
showSetupSignals = input.bool(true, "显示候选信号", tooltip = "先在回撤区扫短期点并收回，再由后续趋势 K 线确认。标记是观察信号，不是成交记录。", group = groupCommon, display = display.none)
showObCandidates = input.bool(false, "显示 OB 候选区", tooltip = "OB 候选：中期恢复突破前最近的反向 K 线高低价区间。只是图形线索，不证明存在机构订单。", group = groupCommon, display = display.none)
showFvgCandidates = input.bool(false, "显示 FVG 候选区", tooltip = "FVG 候选：只在中期恢复突破附近查找第一根与第三根 K 线高低范围不重叠的缺口；不对每个短期点单独画区，也不等于所有失衡。", group = groupCommon, display = display.none)
onlyOverlappingBreakZones = input.bool(false, "只显示与当前回撤区重合的同向区域", tooltip = "默认关闭：启用 OB/FVG 后可查看全部仍有效的候选区。开启时只显示与当前有效中期回撤区价格重叠、方向一致的区域；其他区域仍按原规则跟踪失效，但暂时隐藏。", group = groupCommon, display = display.none)

alertSetupTouch = input.bool(true, "提醒：进入回撤区", tooltip = "当前有效中期回撤区首次到价时提醒，不要求完成扫荡确认。", group = groupAlerts, display = display.none)
alertObTouch = input.bool(true, "提醒：进入 OB", tooltip = "只提醒已启用、符合当前显示过滤的活跃 OB；灰色历史框不提醒。", group = groupAlerts, display = display.none)
alertFvgTouch = input.bool(true, "提醒：进入 FVG", tooltip = "只提醒已启用、符合当前显示过滤的活跃 FVG；首次触及失效模式下，会先提醒再收起区域。", group = groupAlerts, display = display.none)
touchAlertTiming = input.string("即时到价", "提醒时机", options = ["即时到价", "收盘检查"], tooltip = "即时到价：实时最新价格进入区域即提醒。收盘检查：收盘时检查整根 K 线是否触及。同一区域只提醒一次；跳空直接越过区域不视为即时到价。更新脚本或设置后需重新创建 TradingView 提醒，条件选择任何 alert() 函数调用。", group = groupAlerts, display = display.none)

leftBars = input.int(1, "左侧确认 K 线数", minval = 1, maxval = 20, tooltip = "孤立高点必须高于左侧这些 K 线；孤立低点必须低于它们。", group = groupShort, display = display.none, active = advancedSettings)
rightBars = input.int(1, "右侧确认 K 线数", minval = 1, maxval = 20, tooltip = "短期点要等右侧这些 K 线收完才确认；图上标记会回绘到极值 K 线。", group = groupShort, display = display.none, active = advancedSettings)
showShortPoints = input.bool(false, "显示短期点", tooltip = "显示原始孤立高低点；它们不一定都保留在合并后的短期结构线上。默认关闭以突出当前待扫点。", group = groupShort, display = display.none, active = advancedSettings)
showShortLines = input.bool(true, "显示短期结构线", tooltip = "连接处理连续同类点与内包之后的短期高低点。", group = groupShort, display = display.none, active = advancedSettings)
shortContainment = input.string("严格内包", "内包处理", options = ["严格内包", "含边界内包", "关闭"], tooltip = "内包指后一个高低区间落在前一个区间内。严格模式不允许碰边，含边界模式允许相等；这里只整理短期折线。", group = groupShort, display = display.none, active = advancedSettings)

startTime = input.time(timestamp("01 Jan 2020 00:00 +0000"), "趋势起始时间", tooltip = "只用此时间之后形成的短期点建立中期候选结构；不是交易入场时间。", group = groupMid, display = display.none, active = advancedSettings)
breakMode = input.string("影线", "突破依据", options = ["影线", "收盘价"], tooltip = "影线：最高/最低价刺破就算结构突破；收盘价：必须收在边界外。两者都不要求后续 K 线跟进。", group = groupMid, display = display.none, active = advancedSettings)
midContainment = input.string("严格内包", "内包处理", options = ["严格内包", "含边界内包", "关闭"], tooltip = "内包是后一个高低区间落在前一个区间之内。这里只整理中期折线，不改变原始短期点。", group = groupMid, display = display.none, active = advancedSettings)

retireAfterMissedTouch = input.bool(true, "触区后顺势离开即结束", tooltip = "回撤区曾被影线或实体触及后，若收盘顺势离开区域且没有等待确认的扫荡，就结束本次候选机会。关闭可允许之后再次回到区域。", group = groupSetup, display = display.none, active = advancedSettings)
setupFibNear = input.float(0.5, "回撤区起点", minval = 0.0, maxval = 1.0, step = 0.001, tooltip = "从摆动终点向起点回撤的比例；0 是终点，1 是起点。两个端点输入顺序可互换。", group = groupSetup, display = display.none, active = advancedSettings)
setupFibFar = input.float(0.618, "回撤区终点", minval = 0.0, maxval = 1.0, step = 0.001, tooltip = "候选扫荡必须触及两条回撤线之间的价格范围；不是自动挂单价。", group = groupSetup, display = display.none, active = advancedSettings)
requireNewShortPoint = input.bool(true, "只扫摆动终点后的短期点", tooltip = "扫荡目标须是摆动终点之后形成且在当前 K 线之前已确认的孤立高低点。", group = groupSetup, display = display.none, active = advancedSettings)
minSweepTicks = input.int(1, "最小刺破跳动数", minval = 1, maxval = 100, tooltip = "扫荡须越过短期高低点至少这么多个最小价格跳动；1 跳由品种的最小报价单位决定。", group = groupSetup, display = display.none, active = advancedSettings)
minReclaimTicks = input.int(1, "最小收回跳动数", minval = 1, maxval = 100, tooltip = "刺破后，本根 K 线收盘须回到短期点内侧至少这么多个最小价格跳动。", group = groupSetup, display = display.none, active = advancedSettings)
confirmationBars = input.int(3, "扫荡后确认期限（根）", minval = 1, maxval = 20, tooltip = "扫荡之后最多等待多少根 K 线出现同方向趋势 K 线；不允许扫荡与确认同根完成。", group = groupSetup, display = display.none, active = advancedSettings)
maxSetupBars = input.int(60, "摆动确认后最长等待（根）", minval = 1, maxval = 500, tooltip = "从顺势摆动实际确认的 K 线起计；超期不再接受扫荡或确认信号。", group = groupSetup, display = display.none, active = advancedSettings)

minBodyFraction = input.float(0.5, "趋势 K 线最小实体占比", minval = 0.0, maxval = 1.0, step = 0.05, tooltip = "实体长度除以整根 K 线的高低价范围；这是单根推进的量化代理，不是整段趋势动能评分。", group = groupMomentum, display = display.none, active = advancedSettings)
minClosePosition = input.float(0.7, "趋势 K 线收盘位置", minval = 0.5, maxval = 1.0, step = 0.05, tooltip = "多头收盘须位于本根高低区间靠高点的一侧，空头镜像；还要求收盘比前一根向交易方向推进。", group = groupMomentum, display = display.none, active = advancedSettings)
minCloseMoveAtr = input.float(0.0, "最小收盘推进（ATR 倍）", minval = 0.0, maxval = 5.0, step = 0.05, tooltip = "ATR 是近期平均真实波幅。0 表示只要求收盘价比前收盘推进；调高会过滤较小的推进。", group = groupMomentum, display = display.none, active = advancedSettings)
trendAtrLength = input.int(14, "推进 ATR 周期", minval = 1, maxval = 100, tooltip = "计算上方最小推进阈值所用的 ATR 回看 K 线数。", group = groupMomentum, display = display.none, active = advancedSettings)

obLookback = input.int(10, "反向 K 线回看根数", minval = 1, maxval = 50, tooltip = "从突破 K 线向前最多查找多少根，取最近一根反向 K 线作为 OB 候选来源。", group = groupBreakZones, display = display.none, active = advancedSettings)
fvgLookback = input.int(3, "缺口回看根数", minval = 1, maxval = 10, tooltip = "突破时从当前 K 线向前查找最近几组三 K 线缺口；已按所选失效口径回补的缺口不标。", group = groupBreakZones, display = display.none, active = advancedSettings)
minFvgTicks = input.int(1, "缺口最小跳动数", minval = 1, maxval = 100, tooltip = "三 K 线缺口至少宽多少个品种最小价格跳动。", group = groupBreakZones, display = display.none, active = advancedSettings)
obInvalidMode = input.string("收盘价", "反向 K 线区失效依据", options = ["影线", "收盘价"], tooltip = "多头 OB 候选以区域下边界为远端，空头以上边界为远端。影线模式触及即失效；收盘价模式要求收在远端外。", group = groupBreakZones, display = display.none, active = advancedSettings)
fvgFillMode = input.string("完全回补", "缺口失效依据", options = ["完全回补", "首次触及"], tooltip = "完全回补：价格走到缺口远端才失效；首次触及：一碰到缺口近端就失效。", group = groupBreakZones, display = display.none, active = advancedSettings)
maxZoneBars = input.int(60, "候选区最长有效期（根）", minval = 1, maxval = 500, tooltip = "从中期突破确认、候选区被创建时起计；超过期限后不再显示为活跃区。", group = groupBreakZones, display = display.none, active = advancedSettings)
replaceSameSideZone = input.bool(true, "同向新区替换旧区", tooltip = "新多头/空头 OB 或 FVG 候选出现时，让同类同方向旧区失效，减少重叠。", group = groupBreakZones, display = display.none, active = advancedSettings)

keepExpiredSetupZones = input.bool(true, "保留已结束回撤区供复盘", tooltip = "开启：回撤区结束后停止向右延伸并变灰；灰框不是当前机会。关闭则直接删除。", group = groupHistory, display = display.none, active = advancedSettings)
maxExpiredSetupZones = input.int(6, "历史回撤区保留数量", minval = 1, maxval = 20, tooltip = "只保留最近几个已结束回撤区，避免 1 分钟图堆满灰框；仅在上方复盘开关开启时生效。", group = groupHistory, display = display.none, active = advancedSettings)
keepExpiredZones = input.bool(false, "保留失效区域供复盘", tooltip = "关闭：失效方框直接删除。开启：停止延伸并变灰，仅作历史复盘，不能当作当前有效区域。", group = groupHistory, display = display.none, active = advancedSettings)
maxCandidateZones = input.int(4, "每类最多活跃区域数", minval = 1, maxval = 30, tooltip = "OB 与 FVG 分别计数；超过上限时最旧活跃区失效。", group = groupHistory, display = display.none, active = advancedSettings)
maxExpiredZones = input.int(20, "每类最多保留历史区域数", minval = 1, maxval = 50, tooltip = "仅在保留失效区域开启时生效；OB 与 FVG 分别计数，超额删除最旧历史框。", group = groupHistory, display = display.none, active = advancedSettings)

showMidFib = input.bool(false, "显示最近一段摆动参考位", tooltip = "灰色虚线按最后一段中期折线绘制；0 是摆动终点，1 是起点，只表示结构参考，不表示做多或做空。默认关闭以减少重叠。", group = groupFib, display = display.none, active = advancedSettings)
showTradeFib = input.bool(false, "显示顺势交易回撤位", tooltip = "显示已确认中期顺势摆动的 0.618、0.786 参考线。与下方候选回撤区通常二选一显示，避免 0.618 附近重叠；关闭此线不影响回撤扫荡信号。", group = groupFib, display = display.none, active = advancedSettings)
fibLongColor = input.color(color.teal, "顺势多头颜色", group = groupFib, display = display.none, active = advancedSettings)
fibShortColor = input.color(color.red, "顺势空头颜色", group = groupFib, display = display.none, active = advancedSettings)

shortColor = color.new(color.teal, 15)
midColor = color.rgb(194, 64, 55)
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)
leftHigh = ta.highest(high[rightBars + 1], leftBars)
rightHigh = ta.highest(high, rightBars)
leftLow = ta.lowest(low[rightBars + 1], leftBars)
rightLow = ta.lowest(low, rightBars)
strictHigh = not na(ph) and high[rightBars] > leftHigh and high[rightBars] > rightHigh
strictLow = not na(pl) and low[rightBars] < leftLow and low[rightBars] < rightLow
// 同一根 K 线同时形成高低点时，日内先后顺序未知，不强行连接。
ambiguous = strictHigh and strictLow
newHigh = barstate.isconfirmed and strictHigh and not ambiguous
newLow = barstate.isconfirmed and strictLow and not ambiguous
plotshape(showShortPoints and newHigh ? ph : na, "短期高点", shape.triangledown, location.absolute, shortColor, offset = -rightBars, size = size.tiny)
plotshape(showShortPoints and newLow ? pl : na, "短期低点", shape.triangleup, location.absolute, shortColor, offset = -rightBars, size = size.tiny)

// Each pair of alternating pivots defines a high/low range. An inner pair
// does not contribute a turn to the displayed structure.
addPoint(array<int> types, array<float> prices, array<int> times, array<line> segments, int pointType, float pointPrice, int pointTime, color stroke, int width, bool visible, string containmentMode) =>
    int count = array.size(types)
    if count > 0 and array.get(types, count - 1) == pointType
        float previous = array.get(prices, count - 1)
        bool moreExtreme = pointType == 1 ? pointPrice > previous : pointPrice < previous
        if moreExtreme
            array.set(prices, count - 1, pointPrice)
            array.set(times, count - 1, pointTime)
            if count > 1
                line segment = array.get(segments, count - 2)
                if not na(segment)
                    line.set_x2(segment, pointTime)
                    line.set_y2(segment, pointPrice)
    else
        line segment = na
        if count > 0
            if visible
                segment := line.new(array.get(times, count - 1), array.get(prices, count - 1), pointTime, pointPrice, xloc = xloc.bar_time, color = stroke, width = width)
            array.push(segments, segment)
        array.push(types, pointType)
        array.push(prices, pointPrice)
        array.push(times, pointTime)
        count := array.size(types)
        if containmentMode != "关闭" and count >= 4
            int outerFirstType = array.get(types, count - 4)
            int outerSecondType = array.get(types, count - 3)
            int innerFirstType = array.get(types, count - 2)
            int innerSecondType = array.get(types, count - 1)
            bool sameDirection = outerFirstType == innerFirstType and outerSecondType == innerSecondType
            float outerHigh = math.max(array.get(prices, count - 4), array.get(prices, count - 3))
            float outerLow = math.min(array.get(prices, count - 4), array.get(prices, count - 3))
            float innerHigh = math.max(array.get(prices, count - 2), array.get(prices, count - 1))
            float innerLow = math.min(array.get(prices, count - 2), array.get(prices, count - 1))
            bool inside = containmentMode == "严格内包" ? innerHigh < outerHigh and innerLow > outerLow : innerHigh <= outerHigh and innerLow >= outerLow
            if sameDirection and inside
                for i = 0 to 1
                    line removed = array.pop(segments)
                    if not na(removed)
                        line.delete(removed)
                    array.pop(types)
                    array.pop(prices)
                    array.pop(times)
    array.size(types)

// Confirmation order can differ from pivot order. Store unique pivots by their
// actual bar time and rebuild the medium structure in chronological order.
recordMidPoint(array<int> types, array<float> prices, array<int> times, int pointType, float pointPrice, int pointTime) =>
    int position = 0
    while position < array.size(times) and array.get(times, position) < pointTime
        position += 1
    if position == array.size(times) or array.get(times, position) != pointTime
        array.insert(types, position, pointType)
        array.insert(prices, position, pointPrice)
        array.insert(times, position, pointTime)
    else if array.get(types, position) == pointType
        float previous = array.get(prices, position)
        if pointType == 1 ? pointPrice > previous : pointPrice < previous
            array.set(prices, position, pointPrice)
    if array.size(times) > 200
        array.shift(types)
        array.shift(prices)
        array.shift(times)
    array.size(times)

retireCandidateZone(array<box> zones, array<int> sides, array<int> bornBars, array<bool> seen, array<box> history, int position, bool keepHistory, int historyLimit, int endTime, string kind) =>
    box candidate = array.remove(zones, position)
    array.remove(sides, position)
    array.remove(bornBars, position)
    bool wasVisible = array.remove(seen, position)
    if keepHistory and wasVisible
        box.set_right(candidate, endTime)
        box.set_border_color(candidate, color.new(color.gray, 65))
        box.set_bgcolor(candidate, color.new(color.gray, 93))
        box.set_text_color(candidate, color.gray)
        box.set_border_width(candidate, 1)
        box.set_border_style(candidate, line.style_dotted)
        box.set_text(candidate, "已失效 " + kind)
        array.push(history, candidate)
        if array.size(history) > historyLimit
            box.delete(array.shift(history))
    else
        box.delete(candidate)
    array.size(zones)

zoneDirectionText(string kind, int side, int referenceSide) =>
    referenceSide == 0 ? (side == 1 ? "多头 " : "空头 ") + kind + " · 方向未确认" : side == referenceSide ? (side == 1 ? "顺势多 " : "顺势空 ") + kind : "逆势 " + kind + (side == 1 ? " · 支撑" : " · 阻力")

styleCandidateZone(box candidate, color zoneColor, bool visible, string kind, int side, int referenceSide) =>
    bool aligned = referenceSide != 0 and side == referenceSide
    color stroke = referenceSide == 0 ? color.gray : zoneColor
    box.set_border_color(candidate, color.new(stroke, visible ? (aligned ? 10 : 65) : 100))
    box.set_bgcolor(candidate, color.new(stroke, visible ? (aligned ? 87 : 96) : 100))
    box.set_border_width(candidate, aligned ? 2 : 1)
    box.set_border_style(candidate, aligned ? line.style_solid : line.style_dashed)
    box.set_text(candidate, zoneDirectionText(kind, side, referenceSide))
    box.set_text_color(candidate, color.new(referenceSide == 0 ? color.gray : color.black, visible ? (aligned ? 0 : 35) : 100))
    visible

// varip keys survive realtime rollback, so one zone cannot notify on every tick.
rememberTouch(array<string> keys, string key) =>
    bool fresh = not array.includes(keys, key)
    if fresh
        array.push(keys, key)
        if array.size(keys) > 500
            array.shift(keys)
    fresh

touchesAlertZone(float top, float bottom, bool closeCheck) =>
    closeCheck ? high >= bottom and low <= top : close >= bottom and close <= top

candidateTouchMessage(array<box> zones, array<int> sides, array<int> bornBars, array<string> keys, string kind, bool enabled, bool closeCheck, bool overlapOnly, bool activeSetup, int setupSide, float setupTopPrice, float setupBottomPrice, bool breakUpNow, bool breakDownNow) =>
    string message = ""
    if enabled and array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            box zone = array.get(zones, i)
            int side = array.get(sides, i)
            float top = box.get_top(zone)
            float bottom = box.get_bottom(zone)
            bool visible = not overlapOnly or (activeSetup and side == setupSide and top >= setupBottomPrice and bottom <= setupTopPrice)
            bool reversed = barstate.isconfirmed and (side == 1 ? breakDownNow : breakUpNow)
            bool expired = bar_index - array.get(bornBars, i) > maxZoneBars
            // Only revisit zones known before this bar; creation-bar price is not a return.
            if visible and not reversed and not expired and bar_index > array.get(bornBars, i) and touchesAlertZone(top, bottom, closeCheck)
                string key = kind + ":" + str.tostring(array.get(bornBars, i)) + ":" + str.tostring(box.get_left(zone)) + ":" + str.tostring(side)
                if rememberTouch(keys, key)
                    message += zoneDirectionText(kind, side, setupSide) + " 到价 [" + str.tostring(bottom, format.mintick) + ", " + str.tostring(top, format.mintick) + "]\n"
    message

addCandidateZone(array<box> zones, array<int> sides, array<int> bornBars, array<bool> seen, array<box> history, int leftTime, float zoneTop, int rightTime, float zoneBottom, color zoneColor, string zoneName, int side, int activeLimit, bool keepHistory, int historyLimit, bool visible, int referenceSide) =>
    box candidate = box.new(leftTime, zoneTop, rightTime, zoneBottom, xloc = xloc.bar_time, border_color = color.new(zoneColor, 45), bgcolor = color.new(zoneColor, 92), text = zoneName, text_color = color.black, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
    styleCandidateZone(candidate, zoneColor, visible, zoneName, side, referenceSide)
    array.push(zones, candidate)
    array.push(sides, side)
    array.push(bornBars, bar_index)
    array.push(seen, visible)
    if array.size(zones) > activeLimit
        retireCandidateZone(zones, sides, bornBars, seen, history, 0, keepHistory, historyLimit, rightTime, zoneName)
    array.size(zones)

updateCandidateZones(array<box> zones, array<int> sides, array<int> bornBars, array<bool> seen, array<box> history, bool isFvg, string obMode, string fvgMode, int ageLimit, bool breakUp, bool breakDown, bool keepHistory, int historyLimit, int endTime, bool overlapOnly, bool setupIsActive, int setupSide, float setupTopPrice, float setupBottomPrice) =>
    int position = array.size(zones) - 1
    while position >= 0
        box candidate = array.get(zones, position)
        int side = array.get(sides, position)
        float top = box.get_top(candidate)
        float bottom = box.get_bottom(candidate)
        bool reversed = side == 1 ? breakDown : breakUp
        bool crossed = false
        if isFvg
            if side == 1
                crossed := fvgMode == "首次触及" ? low <= top : low <= bottom
            else
                crossed := fvgMode == "首次触及" ? high >= bottom : high >= top
        else
            if side == 1
                crossed := obMode == "影线" ? low <= bottom : close < bottom
            else
                crossed := obMode == "影线" ? high >= top : close > top
        bool expired = bar_index - array.get(bornBars, position) > ageLimit
        if barstate.isconfirmed and (reversed or crossed or expired)
            retireCandidateZone(zones, sides, bornBars, seen, history, position, keepHistory, historyLimit, endTime, isFvg ? "FVG" : "OB")
        else
            box.set_right(candidate, endTime)
            color zoneColor = isFvg ? (side == 1 ? color.lime : color.orange) : (side == 1 ? fibLongColor : fibShortColor)
            bool visible = not overlapOnly or (setupIsActive and side == setupSide and top >= setupBottomPrice and bottom <= setupTopPrice)
            styleCandidateZone(candidate, zoneColor, visible, isFvg ? "FVG" : "OB", side, setupSide)
            if visible
                array.set(seen, position, true)
        position -= 1
    array.size(zones)

retireSameSideZones(array<box> zones, array<int> sides, array<int> bornBars, array<bool> seen, array<box> history, int side, bool keepHistory, int historyLimit, int endTime, string kind) =>
    int position = array.size(zones) - 1
    while position >= 0
        if array.get(sides, position) == side
            retireCandidateZone(zones, sides, bornBars, seen, history, position, keepHistory, historyLimit, endTime, kind)
        position -= 1
    array.size(zones)

var shortTypes = array.new_int()
var shortPrices = array.new_float()
var shortTimes = array.new_int()
var shortSegments = array.new_line()
var midTypes = array.new_int()
var midPrices = array.new_float()
var midTimes = array.new_int()
var midSegments = array.new_line()
var midEventTypes = array.new_int()
var midEventPrices = array.new_float()
var midEventTimes = array.new_int()
var midLabels = array.new_label()
var fibLines = array.new_line()
var fibLabels = array.new_label()
var fibRatios = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)
var tradeFibLines = array.new_line()
var tradeFibLabels = array.new_label()
var tradeMidTypes = array.new_int()
var tradeMidPrices = array.new_float()
var tradeMidTimes = array.new_int()
var tradeMidSegments = array.new_line()
var tradeFibRatios = array.from(0.618, 0.786)
var int tradeSide = 0
var float tradeSwingStart = na
var float tradeSwingEnd = na
var int tradeSwingStartTime = na
var int tradeSwingEndTime = na
var int tradeConfirmedTime = na
var int lastTradeSwingEndTime = na
var int tradeConfirmedBar = na
var int previousShortLowTime = na
var int previousShortHighTime = na
var int pendingSweepSide = 0
var int pendingSweepBar = na
var int setupSwingBar = na
var int signaledSwingBar = na
var int consumedSwingBar = na
var bool setupTouched = false
varip touchAlertKeys = array.new_string()
var obZones = array.new_box()
var obZoneSides = array.new_int()
var obZoneBornBars = array.new_int()
var obZoneSeen = array.new_bool()
var obZoneHistory = array.new_box()
var fvgZones = array.new_box()
var fvgZoneSides = array.new_int()
var fvgZoneBornBars = array.new_int()
var fvgZoneSeen = array.new_bool()
var fvgZoneHistory = array.new_box()
var box setupZone = na
var setupZoneHistory = array.new_box()
var line setupInvalidationLine = na
var label setupInvalidationLabel = na
var line sweepTargetLine = na
var label sweepTargetLabel = na

// 原始孤立点标记保留；内包只从结构折线中合并。
if newHigh or newLow
    addPoint(shortTypes, shortPrices, shortTimes, shortSegments, newHigh ? 1 : -1, newHigh ? ph : pl, time[rightBars], shortColor, 1, showShortLines, shortContainment)

// 中期确认使用已确认的短期点。突破只在确认 K 线及其后发生，
// 避免将右侧确认期间的历史价格当作事先已知的信号。
inTrend = time >= startTime
pointInTrend = time[rightBars] >= startTime
breakUp = breakMode == "影线" ? high : close
breakDown = breakMode == "影线" ? low : close
var float previousShortLow = na
var int previousShortLowIndex = na
var float previousShortHigh = na
var int previousShortHighIndex = na
var float candidateHigh = na
var int candidateHighIndex = na
var int candidateHighTime = na
var float candidateHighBase = na
var float candidateLow = na
var int candidateLowIndex = na
var int candidateLowTime = na
var float candidateLowBase = na
var float confirmedMidHigh = na
var int confirmedMidHighIndex = na
var float confirmedMidLow = na
var int confirmedMidLowIndex = na
var float pendingLow = na
var int pendingLowIndex = na
var int pendingLowTime = na
var float pendingHigh = na
var int pendingHighIndex = na
var int pendingHighTime = na
bool newMidHigh = false
bool newMidLow = false
bool autoConflict = false
bool autoSwitchUp = false
bool autoSwitchDown = false
bool midBreakUp = false
bool midBreakDown = false
var int autoDirection = 0
float sweepRefLow = previousShortLow
float sweepRefHigh = previousShortHigh
int sweepRefLowTime = previousShortLowTime
int sweepRefHighTime = previousShortHighTime

if inTrend
    bool trackUpRules = trendMode != "下跌"
    bool trackDownRules = trendMode != "上涨"
    if newLow and pointInTrend
        previousShortLow := pl
        previousShortLowIndex := bar_index - rightBars
        previousShortLowTime := time[rightBars]
        if trackUpRules and ((not na(candidateHighIndex) and previousShortLowIndex > candidateHighIndex) or (not na(confirmedMidHighIndex) and previousShortLowIndex > confirmedMidHighIndex))
            if na(pendingLow) or pl < pendingLow
                pendingLow := pl
                pendingLowIndex := previousShortLowIndex
                pendingLowTime := time[rightBars]
    if newHigh and pointInTrend
        previousShortHigh := ph
        previousShortHighIndex := bar_index - rightBars
        previousShortHighTime := time[rightBars]
        if trackDownRules and ((not na(candidateLowIndex) and previousShortHighIndex > candidateLowIndex) or (not na(confirmedMidLowIndex) and previousShortHighIndex > confirmedMidLowIndex))
            if na(pendingHigh) or ph > pendingHigh
                pendingHigh := ph
                pendingHighIndex := previousShortHighIndex
                pendingHighTime := time[rightBars]

    if trackUpRules and newHigh and pointInTrend and not na(previousShortLow) and previousShortLowIndex < previousShortHighIndex
        if na(candidateHigh) or ph > candidateHigh
            candidateHigh := ph
            candidateHighIndex := previousShortHighIndex
            candidateHighTime := time[rightBars]
            candidateHighBase := previousShortLow
    if trackDownRules and newLow and pointInTrend and not na(previousShortHigh) and previousShortHighIndex < previousShortLowIndex
        if na(candidateLow) or pl < candidateLow
            candidateLow := pl
            candidateLowIndex := previousShortLowIndex
            candidateLowTime := time[rightBars]
            candidateLowBase := previousShortHigh

    bool rawMidHighEvent = barstate.isconfirmed and trackUpRules and not na(candidateHighBase) and breakDown < candidateHighBase and bar_index > candidateHighIndex
    bool rawMidLowEvent = barstate.isconfirmed and trackDownRules and not na(candidateLowBase) and breakUp > candidateLowBase and bar_index > candidateLowIndex
    bool rawRecoveryUp = barstate.isconfirmed and trackUpRules and not na(confirmedMidHigh) and not na(pendingLow) and breakUp > confirmedMidHigh
    bool rawRecoveryDown = barstate.isconfirmed and trackDownRules and not na(confirmedMidLow) and not na(pendingHigh) and breakDown < confirmedMidLow
    bool upwardBreak = rawMidLowEvent or rawRecoveryUp
    bool downwardBreak = rawMidHighEvent or rawRecoveryDown
    autoConflict := trendMode == "自动/双向" and upwardBreak and downwardBreak
    // A direct candidate break takes precedence over a recovery confirmation
    // in the same direction, so one bar cannot emit the same point twice.
    bool midHighEvent = rawMidHighEvent and not autoConflict
    bool midLowEvent = rawMidLowEvent and not autoConflict
    bool recoveryUp = rawRecoveryUp and not rawMidLowEvent and not autoConflict
    bool recoveryDown = rawRecoveryDown and not rawMidHighEvent and not autoConflict
    midBreakUp := recoveryUp
    midBreakDown := recoveryDown

    if trendMode == "自动/双向" and not autoConflict
        if upwardBreak and autoDirection != 1
            autoDirection := 1
            autoSwitchUp := true
        else if downwardBreak and autoDirection != -1
            autoDirection := -1
            autoSwitchDown := true

    if midHighEvent
        newMidHigh := true
        confirmedMidHigh := candidateHigh
        confirmedMidHighIndex := candidateHighIndex
        if na(pendingLowIndex) or pendingLowIndex <= candidateHighIndex
            pendingLow := na
            pendingLowIndex := na
            pendingLowTime := na
        recordMidPoint(midEventTypes, midEventPrices, midEventTimes, 1, candidateHigh, candidateHighTime)
        candidateHigh := na
        candidateHighBase := na
    else if recoveryUp
        newMidLow := true
        confirmedMidLow := pendingLow
        confirmedMidLowIndex := pendingLowIndex
        recordMidPoint(midEventTypes, midEventPrices, midEventTimes, -1, pendingLow, pendingLowTime)
        confirmedMidHigh := na
        confirmedMidHighIndex := na
        pendingLow := na
        pendingLowIndex := na
        pendingLowTime := na

    if midLowEvent
        newMidLow := true
        confirmedMidLow := candidateLow
        confirmedMidLowIndex := candidateLowIndex
        if na(pendingHighIndex) or pendingHighIndex <= candidateLowIndex
            pendingHigh := na
            pendingHighIndex := na
            pendingHighTime := na
        recordMidPoint(midEventTypes, midEventPrices, midEventTimes, -1, candidateLow, candidateLowTime)
        candidateLow := na
        candidateLowBase := na
    else if recoveryDown
        newMidHigh := true
        confirmedMidHigh := pendingHigh
        confirmedMidHighIndex := pendingHighIndex
        recordMidPoint(midEventTypes, midEventPrices, midEventTimes, 1, pendingHigh, pendingHighTime)
        confirmedMidLow := na
        confirmedMidLowIndex := na
        pendingHigh := na
        pendingHighIndex := na
        pendingHighTime := na

// Rebuild only when a medium point is confirmed; never infer a trade setup
// from the final chart's retrospectively redrawn structure.
if newMidHigh or newMidLow
    array.clear(tradeMidTypes)
    array.clear(tradeMidPrices)
    array.clear(tradeMidTimes)
    array.clear(tradeMidSegments)
    if array.size(midEventTimes) > 0
        for i = 0 to array.size(midEventTimes) - 1
            addPoint(tradeMidTypes, tradeMidPrices, tradeMidTimes, tradeMidSegments, array.get(midEventTypes, i), array.get(midEventPrices, i), array.get(midEventTimes, i), midColor, 2, false, midContainment)

    float latestHigh = na
    float previousHigh = na
    float latestLow = na
    float previousLow = na
    int tradeMidCount = array.size(tradeMidTypes)
    if tradeMidCount > 0
        for i = 0 to tradeMidCount - 1
            if array.get(tradeMidTypes, i) == 1
                previousHigh := latestHigh
                latestHigh := array.get(tradeMidPrices, i)
            else
                previousLow := latestLow
                latestLow := array.get(tradeMidPrices, i)
    int structureSide = not na(previousHigh) and not na(previousLow) and latestHigh > previousHigh and latestLow > previousLow ? 1 : not na(previousHigh) and not na(previousLow) and latestHigh < previousHigh and latestLow < previousLow ? -1 : 0
    if (trendMode == "上涨" and structureSide == -1) or (trendMode == "下跌" and structureSide == 1)
        structureSide := 0
    if structureSide != tradeSide
        tradeSide := 0
    if tradeSide != 0
        bool retainedSwing = false
        if tradeMidCount >= 2
            for i = 0 to tradeMidCount - 2
                if array.get(tradeMidTimes, i) == tradeSwingStartTime and array.get(tradeMidTimes, i + 1) == tradeSwingEndTime and array.get(tradeMidPrices, i) == tradeSwingStart and array.get(tradeMidPrices, i + 1) == tradeSwingEnd
                    retainedSwing := true
        if not retainedSwing
            tradeSide := 0

    int swingPosition = na
    if structureSide != 0 and tradeMidCount >= 2
        for i = tradeMidCount - 2 to math.max(0, tradeMidCount - 3)
            if na(swingPosition) and array.get(tradeMidTypes, i) == -structureSide and array.get(tradeMidTypes, i + 1) == structureSide
                swingPosition := i
    if not na(swingPosition)
        int candidateEndTime = array.get(tradeMidTimes, swingPosition + 1)
        if na(lastTradeSwingEndTime) or candidateEndTime > lastTradeSwingEndTime
            tradeSide := structureSide
            tradeSwingStart := array.get(tradeMidPrices, swingPosition)
            tradeSwingEnd := array.get(tradeMidPrices, swingPosition + 1)
            tradeSwingStartTime := array.get(tradeMidTimes, swingPosition)
            tradeSwingEndTime := candidateEndTime
            tradeConfirmedTime := time
            tradeConfirmedBar := bar_index
            lastTradeSwingEndTime := candidateEndTime

if barstate.isconfirmed and tradeSide == 1 and low <= tradeSwingStart
    tradeSide := 0
if barstate.isconfirmed and tradeSide == -1 and high >= tradeSwingStart
    tradeSide := 0

float fibNear = math.min(setupFibNear, setupFibFar)
float fibFar = math.max(setupFibNear, setupFibFar)
float setupNearPrice = tradeSwingEnd + (tradeSwingStart - tradeSwingEnd) * fibNear
float setupFarPrice = tradeSwingEnd + (tradeSwingStart - tradeSwingEnd) * fibFar
float setupTop = math.max(setupNearPrice, setupFarPrice)
float setupBottom = math.min(setupNearPrice, setupFarPrice)
bool setupActive = tradeSide != 0 and not na(tradeConfirmedBar) and bar_index - tradeConfirmedBar <= maxSetupBars and (na(signaledSwingBar) or signaledSwingBar != tradeConfirmedBar) and (na(consumedSwingBar) or consumedSwingBar != tradeConfirmedBar)
if na(setupSwingBar) or setupSwingBar != tradeConfirmedBar
    setupSwingBar := tradeConfirmedBar
    pendingSweepSide := 0
    pendingSweepBar := na
    setupTouched := false
if not setupActive
    pendingSweepSide := 0
    pendingSweepBar := na

// Notify before first-touch retirement or setup consumption on this bar.
bool closeTouchCheck = touchAlertTiming == "收盘检查"
if barstate.isrealtime and (not closeTouchCheck or barstate.isconfirmed)
    string touchMessage = ""
    if alertSetupTouch and setupActive and bar_index > tradeConfirmedBar and touchesAlertZone(setupTop, setupBottom, closeTouchCheck)
        string setupKey = "回撤:" + str.tostring(tradeConfirmedBar) + ":" + str.tostring(tradeSide)
        if rememberTouch(touchAlertKeys, setupKey)
            touchMessage += (tradeSide == 1 ? "多头" : "空头") + "回撤区到价 [" + str.tostring(setupBottom, format.mintick) + ", " + str.tostring(setupTop, format.mintick) + "]\n"
    touchMessage += candidateTouchMessage(obZones, obZoneSides, obZoneBornBars, touchAlertKeys, "OB", alertObTouch and showObCandidates, closeTouchCheck, onlyOverlappingBreakZones, setupActive, tradeSide, setupTop, setupBottom, midBreakUp or autoSwitchUp, midBreakDown or autoSwitchDown)
    touchMessage += candidateTouchMessage(fvgZones, fvgZoneSides, fvgZoneBornBars, touchAlertKeys, "FVG", alertFvgTouch and showFvgCandidates, closeTouchCheck, onlyOverlappingBreakZones, setupActive, tradeSide, setupTop, setupBottom, midBreakUp or autoSwitchUp, midBreakDown or autoSwitchDown)
    if touchMessage != ""
        alert(syminfo.ticker + " · " + timeframe.period + "\n" + touchMessage + "到达观察区，等待走势确认。", alert.freq_all)

bool longSetupSignal = false
bool shortSetupSignal = false
float candleRange = high - low
float candleBody = math.abs(close - open)
float closeAtr = ta.atr(trendAtrLength)
bool bullishTrendCandle = candleRange > 0 and close > open and close > close[1] and candleBody / candleRange >= minBodyFraction and (close - low) / candleRange >= minClosePosition and close - close[1] >= closeAtr * minCloseMoveAtr
bool bearishTrendCandle = candleRange > 0 and close < open and close < close[1] and candleBody / candleRange >= minBodyFraction and (high - close) / candleRange >= minClosePosition and close[1] - close >= closeAtr * minCloseMoveAtr
bool validSweepLow = not na(sweepRefLow) and (not requireNewShortPoint or sweepRefLowTime > tradeSwingEndTime)
bool validSweepHigh = not na(sweepRefHigh) and (not requireNewShortPoint or sweepRefHighTime > tradeSwingEndTime)
if barstate.isconfirmed and setupActive and bar_index > tradeConfirmedBar
    if not na(pendingSweepBar) and bar_index - pendingSweepBar > confirmationBars
        pendingSweepSide := 0
        pendingSweepBar := na
    if pendingSweepSide == 1 and bar_index > pendingSweepBar and bullishTrendCandle and tradeSide == 1
        longSetupSignal := true
    if pendingSweepSide == -1 and bar_index > pendingSweepBar and bearishTrendCandle and tradeSide == -1
        shortSetupSignal := true
    if longSetupSignal or shortSetupSignal
        signaledSwingBar := tradeConfirmedBar
        pendingSweepSide := 0
        pendingSweepBar := na
        setupActive := false
    else
        bool touchesZone = high >= setupBottom and low <= setupTop
        if touchesZone
            setupTouched := true
        if tradeSide == 1 and touchesZone and validSweepLow and sweepRefLow - low >= minSweepTicks * syminfo.mintick and close - sweepRefLow >= minReclaimTicks * syminfo.mintick
            pendingSweepSide := 1
            pendingSweepBar := bar_index
        if tradeSide == -1 and touchesZone and validSweepHigh and high - sweepRefHigh >= minSweepTicks * syminfo.mintick and sweepRefHigh - close >= minReclaimTicks * syminfo.mintick
            pendingSweepSide := -1
            pendingSweepBar := bar_index
        bool leftWithTrend = tradeSide == 1 ? close > setupTop : close < setupBottom
        if retireAfterMissedTouch and setupTouched and pendingSweepSide == 0 and leftWithTrend
            consumedSwingBar := tradeConfirmedBar
            setupActive := false

if showSetupInvalidation and setupActive
    if na(setupInvalidationLine)
        setupInvalidationLine := line.new(tradeConfirmedTime, tradeSwingStart, time, tradeSwingStart, xloc = xloc.bar_time, color = color.new(color.gray, 35), style = line.style_dotted)
        setupInvalidationLabel := label.new(time, tradeSwingStart, "失效", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.gray, size = size.tiny)
    else
        line.set_xy1(setupInvalidationLine, tradeConfirmedTime, tradeSwingStart)
        line.set_xy2(setupInvalidationLine, time, tradeSwingStart)
        label.set_x(setupInvalidationLabel, time)
        label.set_y(setupInvalidationLabel, tradeSwingStart)
else if not na(setupInvalidationLine)
    line.delete(setupInvalidationLine)
    label.delete(setupInvalidationLabel)
    setupInvalidationLine := na
    setupInvalidationLabel := na

bool hasSweepTarget = tradeSide == 1 ? validSweepLow : validSweepHigh
float sweepTargetPrice = tradeSide == 1 ? sweepRefLow : sweepRefHigh
int sweepTargetTime = tradeSide == 1 ? sweepRefLowTime : sweepRefHighTime
if showSweepTarget and setupActive and hasSweepTarget
    if na(sweepTargetLine)
        sweepTargetLine := line.new(sweepTargetTime, sweepTargetPrice, time, sweepTargetPrice, xloc = xloc.bar_time, color = color.new(color.gray, 25), style = line.style_dashed)
        sweepTargetLabel := label.new(time, sweepTargetPrice, tradeSide == 1 ? "待扫低" : "待扫高", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100), textcolor = color.gray, size = size.tiny)
    else
        line.set_xy1(sweepTargetLine, sweepTargetTime, sweepTargetPrice)
        line.set_xy2(sweepTargetLine, time, sweepTargetPrice)
        label.set_x(sweepTargetLabel, time)
        label.set_y(sweepTargetLabel, sweepTargetPrice)
        label.set_text(sweepTargetLabel, tradeSide == 1 ? "待扫低" : "待扫高")
else if not na(sweepTargetLine)
    line.delete(sweepTargetLine)
    label.delete(sweepTargetLabel)
    sweepTargetLine := na
    sweepTargetLabel := na

if showSetupZone and setupActive and not longSetupSignal and not shortSetupSignal
    color zoneColor = tradeSide == 1 ? fibLongColor : fibShortColor
    if na(setupZone)
        setupZone := box.new(tradeConfirmedTime, setupTop, time, setupBottom, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(zoneColor, 50), bgcolor = color.new(zoneColor, 92), text = "回撤", text_color = color.black, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
    else
        box.set_left(setupZone, tradeConfirmedTime)
        box.set_right(setupZone, time)
        box.set_top(setupZone, setupTop)
        box.set_bottom(setupZone, setupBottom)
        box.set_border_color(setupZone, color.new(zoneColor, 50))
        box.set_bgcolor(setupZone, color.new(zoneColor, 92))
else if not na(setupZone)
    if keepExpiredSetupZones
        box.set_extend(setupZone, extend.none)
        box.set_right(setupZone, time)
        box.set_border_color(setupZone, color.new(color.gray, 65))
        box.set_bgcolor(setupZone, color.new(color.gray, 93))
        box.set_text_color(setupZone, color.gray)
        array.push(setupZoneHistory, setupZone)
        if array.size(setupZoneHistory) > maxExpiredSetupZones
            box.delete(array.shift(setupZoneHistory))
    else
        box.delete(setupZone)
    setupZone := na

// These are observable candidates around a confirmed medium-level break,
// not evidence that institutional orders were placed at either zone.
bool structureBreakUp = midBreakUp or autoSwitchUp
bool structureBreakDown = midBreakDown or autoSwitchDown
updateCandidateZones(obZones, obZoneSides, obZoneBornBars, obZoneSeen, obZoneHistory, false, obInvalidMode, fvgFillMode, maxZoneBars, structureBreakUp, structureBreakDown, keepExpiredZones, maxExpiredZones, time, onlyOverlappingBreakZones, setupActive, tradeSide, setupTop, setupBottom)
updateCandidateZones(fvgZones, fvgZoneSides, fvgZoneBornBars, fvgZoneSeen, fvgZoneHistory, true, obInvalidMode, fvgFillMode, maxZoneBars, structureBreakUp, structureBreakDown, keepExpiredZones, maxExpiredZones, time, onlyOverlappingBreakZones, setupActive, tradeSide, setupTop, setupBottom)
if midBreakUp or midBreakDown
    int breakSide = midBreakUp ? 1 : -1
    if showObCandidates
        int obOffset = na
        for i = 1 to obLookback
            if na(obOffset) and not na(open[i]) and (breakSide == 1 ? close[i] < open[i] : close[i] > open[i])
                obOffset := i
        if not na(obOffset)
            bool obAlreadyInvalid = breakSide == 1 ? (obInvalidMode == "影线" ? low <= low[obOffset] : close < low[obOffset]) : (obInvalidMode == "影线" ? high >= high[obOffset] : close > high[obOffset])
            if not obAlreadyInvalid
                if replaceSameSideZone
                    retireSameSideZones(obZones, obZoneSides, obZoneBornBars, obZoneSeen, obZoneHistory, breakSide, keepExpiredZones, maxExpiredZones, time, "OB")
                bool showOb = not onlyOverlappingBreakZones or (setupActive and breakSide == tradeSide and high[obOffset] >= setupBottom and low[obOffset] <= setupTop)
                addCandidateZone(obZones, obZoneSides, obZoneBornBars, obZoneSeen, obZoneHistory, time[obOffset], high[obOffset], time, low[obOffset], breakSide == 1 ? fibLongColor : fibShortColor, "OB", breakSide, maxCandidateZones, keepExpiredZones, maxExpiredZones, showOb, tradeSide)
    if showFvgCandidates
        int fvgOffset = na
        for i = 0 to fvgLookback - 1
            bool gapFound = breakSide == 1 ? low[i] - high[i + 2] >= minFvgTicks * syminfo.mintick : low[i + 2] - high[i] >= minFvgTicks * syminfo.mintick
            if gapFound and i > 0
                for j = 0 to i - 1
                    bool gapTouched = breakSide == 1 ? (fvgFillMode == "首次触及" ? low[j] <= low[i] : low[j] <= high[i + 2]) : (fvgFillMode == "首次触及" ? high[j] >= high[i] : high[j] >= low[i + 2])
                    if gapTouched
                        gapFound := false
            if na(fvgOffset) and gapFound
                fvgOffset := i
        if not na(fvgOffset)
            float fvgTop = breakSide == 1 ? low[fvgOffset] : low[fvgOffset + 2]
            float fvgBottom = breakSide == 1 ? high[fvgOffset + 2] : high[fvgOffset]
            if replaceSameSideZone
                retireSameSideZones(fvgZones, fvgZoneSides, fvgZoneBornBars, fvgZoneSeen, fvgZoneHistory, breakSide, keepExpiredZones, maxExpiredZones, time, "FVG")
            bool showFvg = not onlyOverlappingBreakZones or (setupActive and breakSide == tradeSide and fvgTop >= setupBottom and fvgBottom <= setupTop)
            addCandidateZone(fvgZones, fvgZoneSides, fvgZoneBornBars, fvgZoneSeen, fvgZoneHistory, time[fvgOffset + 2], fvgTop, time, fvgBottom, breakSide == 1 ? color.lime : color.orange, "FVG", breakSide, maxCandidateZones, keepExpiredZones, maxExpiredZones, showFvg, tradeSide)

// Labels are created only for pivots surviving same-type and containment
// processing, so the chart and the medium structure line describe the same points.
if barstate.islast
    for fibLine in fibLines
        line.delete(fibLine)
    for fibLabel in fibLabels
        label.delete(fibLabel)
    for tradeLine in tradeFibLines
        line.delete(tradeLine)
    for tradeLabel in tradeFibLabels
        label.delete(tradeLabel)
    array.clear(fibLines)
    array.clear(fibLabels)
    array.clear(tradeFibLines)
    array.clear(tradeFibLabels)
    for segment in midSegments
        if not na(segment)
            line.delete(segment)
    for pointLabel in midLabels
        label.delete(pointLabel)
    array.clear(midTypes)
    array.clear(midPrices)
    array.clear(midTimes)
    array.clear(midSegments)
    array.clear(midLabels)
    if array.size(midEventTimes) > 0
        for i = 0 to array.size(midEventTimes) - 1
            addPoint(midTypes, midPrices, midTimes, midSegments, array.get(midEventTypes, i), array.get(midEventPrices, i), array.get(midEventTimes, i), midColor, 2, showMidLines, midContainment)
    if showMidPoints and array.size(midTimes) > 0
        for i = 0 to array.size(midTimes) - 1
            bool isHigh = array.get(midTypes, i) == 1
            label pointLabel = label.new(array.get(midTimes, i), array.get(midPrices, i), isHigh ? "中高" : "中低", xloc = xloc.bar_time, style = isHigh ? label.style_label_down : label.style_label_up, color = midColor, textcolor = color.white, size = size.tiny)
            array.push(midLabels, pointLabel)

    // Use the final two retained medium pivots, after containment processing.
    // Retracement starts at the end of the swing: 0 = end, 1 = start.
    int midCount = array.size(midTimes)
    if showMidFib and midCount >= 2
        float swingStart = array.get(midPrices, midCount - 2)
        float swingEnd = array.get(midPrices, midCount - 1)
        int swingEndTime = array.get(midTimes, midCount - 1)
        if swingStart != swingEnd
            bool longSwing = swingEnd > swingStart
            string fibDirection = longSwing ? "上行摆动 " : "下行摆动 "
            bool sameTradeSwing = tradeSide != 0 and swingStart == tradeSwingStart and swingEnd == tradeSwingEnd
            for ratio in fibRatios
                if not (showTradeFib and sameTradeSwing and (ratio == 0.618 or ratio == 0.786))
                    float level = swingEnd + (swingStart - swingEnd) * ratio
                    line levelLine = line.new(swingEndTime, level, time, level, xloc = xloc.bar_time, extend = extend.right, color = color.new(color.gray, 75), style = line.style_dotted)
                    label levelLabel = label.new(time, level, fibDirection + str.tostring(ratio, "0.###") + "  " + str.tostring(level, format.mintick), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.gray, 90), textcolor = color.gray, size = size.tiny)
                    array.push(fibLines, levelLine)
                    array.push(fibLabels, levelLabel)
    if showTradeFib and tradeSide != 0
        color tradeColor = tradeSide == 1 ? fibLongColor : fibShortColor
        string tradeDirection = tradeSide == 1 ? "顺势多 " : "顺势空 "
        for ratio in tradeFibRatios
            float level = tradeSwingEnd + (tradeSwingStart - tradeSwingEnd) * ratio
            line levelLine = line.new(tradeConfirmedTime, level, time + 1, level, xloc = xloc.bar_time, extend = extend.right, color = tradeColor, width = 2)
            label levelLabel = label.new(bar_index, level, tradeDirection + str.tostring(ratio, "0.###") + "  " + str.tostring(level, format.mintick), style = label.style_label_left, color = color.new(tradeColor, 85), textcolor = tradeColor, size = size.tiny)
            array.push(tradeFibLines, levelLine)
            array.push(tradeFibLabels, levelLabel)

alertcondition(newHigh, "短期高点确认", "短期高点已确认")
alertcondition(newLow, "短期低点确认", "短期低点已确认")
alertcondition(newMidHigh, "中期高点确认", "中期高点已确认")
alertcondition(newMidLow, "中期低点确认", "中期低点已确认")
alertcondition(autoSwitchUp, "自动切换上涨", "中期结构自动切换为上涨")
alertcondition(autoSwitchDown, "自动切换下跌", "中期结构自动切换为下跌")
alertcondition(longSetupSignal, "回撤扫荡多头候选", "回撤区扫荡后出现多头趋势 K 线")
alertcondition(shortSetupSignal, "回撤扫荡空头候选", "回撤区扫荡后出现空头趋势 K 线")
plotshape(showSetupSignals and longSetupSignal, "多头候选", shape.labelup, location.belowbar, fibLongColor, text = "候选多", textcolor = color.white, size = size.tiny)
plotshape(showSetupSignals and shortSetupSignal, "空头候选", shape.labeldown, location.abovebar, fibShortColor, text = "候选空", textcolor = color.white, size = size.tiny)
plotshape(autoSwitchUp, "自动上涨", shape.labelup, location.belowbar, color.new(color.green, 0), text = "涨", textcolor = color.white, size = size.tiny)
plotshape(autoSwitchDown, "自动下跌", shape.labeldown, location.abovebar, color.new(color.red, 0), text = "跌", textcolor = color.white, size = size.tiny)
plotshape(autoConflict, "双向突破冲突", shape.xcross, location.abovebar, color.orange, text = "冲突", textcolor = color.orange, size = size.tiny)
plot(trendMode == "自动/双向" ? autoDirection : na, "自动方向（1 涨 / -1 跌 / 0 未确认）", display = display.data_window)
